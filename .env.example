# EventLens external LLM / Agent configuration.
# Copy to `.env` and set the real key locally. `.env` is ignored by Git.

DEEPSEEK_API_KEY=

EVENTLENS_LLM_PROVIDER=openai_compatible
EVENTLENS_LLM_BASE_URL=https://api.deepseek.com
EVENTLENS_LLM_MODEL=deepseek-v4-pro
EVENTLENS_LLM_API_KEY_ENV=DEEPSEEK_API_KEY
EVENTLENS_LLM_THINKING=enabled
EVENTLENS_LLM_REASONING_EFFORT=max
EVENTLENS_LLM_MAX_TOKENS=2048
EVENTLENS_LLM_TEMPERATURE=0
EVENTLENS_LLM_TIMEOUT_SECONDS=180

EVENTLENS_AGENT_MAX_STEPS=4
EVENTLENS_AGENT_MAX_CONTENT_CHARS=4000
EVENTLENS_AGENT_TRIGGER_CONFIDENCE_MAX=0.65
EVENTLENS_AGENT_TRIGGER_SUBJECT_MARGIN_MAX=0.05

# Agent 目前只做 shadow/HITL 辅助，不自动覆盖 baseline。
# 运行 predict-assets 时显式追加 --agent-shadow 才会调用外部 API。
